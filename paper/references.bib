% The per-pair closed form written out for a rotary head, in polar form:
% S = sum_j |q_j||k_j| cos(alpha_j - beta_j + (m-n) theta_j). This is the same
% identity the paper uses, and the paper says so rather than claiming it.
@article{chachamovits2026phase,
  title   = {Phase Structure in Rotary Attention: A Spectral Framework for
             Semantic Continuity and Execution-Boundary Governance},
  author  = {Chachamovits, Abraham},
  journal = {arXiv preprint arXiv:2607.25507},
  year    = {2026},
  eprint  = {2607.25507},
  archivePrefix = {arXiv},
  primaryClass  = {cs.LG}
}

% The only prior work that attributes a RoPE score per frequency pair with
% verified additivity. It *excludes* sign-inconsistent bands as numerically
% unreliable; the paper's central claim is that they are the phenomenon.
@article{jedryszek2026retrieval,
